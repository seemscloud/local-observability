logging {
  level  = "info"
  format = "logfmt"
}

loki.write "local" {
  endpoint {
    url = "http://observability-loki:3100/loki/api/v1/push"
  }
}

loki.write "remote" {
  endpoint {
    url = sys.env("REMOTE_LOKI_URL")
  }
}

loki.relabel "syslog" {
  forward_to = []

  rule {
    action = "labelmap"
    regex  = "__syslog_(.+)"
  }
}

loki.source.syslog "openwrt" {
  listener {
    address                         = "0.0.0.0:1514"
    protocol                        = "tcp"
    syslog_format                   = "rfc3164"
    use_incoming_timestamp          = true
    rfc3164_default_to_current_year = true
    labels = {
      collector = "alloy",
      site      = sys.env("OBSERVABILITY_SITE"),
      source    = "openwrt",
      transport = "tcp",
    }
  }

  listener {
    address                         = "0.0.0.0:1514"
    protocol                        = "udp"
    syslog_format                   = "rfc3164"
    use_incoming_timestamp          = true
    rfc3164_default_to_current_year = true
    labels = {
      collector = "alloy",
      site      = sys.env("OBSERVABILITY_SITE"),
      source    = "openwrt",
      transport = "udp",
    }
  }

  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.local.receiver, loki.write.remote.receiver]
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "nuc" {
  max_age       = "24h"
  labels        = { host = sys.env("OBSERVABILITY_HOST"), site = sys.env("OBSERVABILITY_SITE"), source = "journal" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.local.receiver, loki.write.remote.receiver]
}

local.file_match "host_var_log" {
  path_targets = [
    {
      __path__ = "/host/var/log/{syslog,messages,*.log}",
      host     = sys.env("OBSERVABILITY_HOST"),
      site     = sys.env("OBSERVABILITY_SITE"),
      source   = "file",
    },
    {
      __path__ = "/host/var/log/{apt,unattended-upgrades,nginx,apache2,audit}/**/*.log",
      host     = sys.env("OBSERVABILITY_HOST"),
      site     = sys.env("OBSERVABILITY_SITE"),
      source   = "file",
    },
  ]
  ignore_older_than = "720h"
  sync_period       = "10s"
}

loki.source.file "host_var_log" {
  targets                 = local.file_match.host_var_log.targets
  forward_to              = [loki.write.local.receiver, loki.write.remote.receiver]
  tail_from_end            = true
  on_positions_file_error = "restart_from_end"
}

discovery.docker "nuc" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker" {
  targets = discovery.docker.nuc.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "nuc" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.nuc.targets
  labels        = { host = sys.env("OBSERVABILITY_HOST"), site = sys.env("OBSERVABILITY_SITE"), source = "docker" }
  relabel_rules = discovery.relabel.docker.rules
  forward_to    = [loki.write.local.receiver, loki.write.remote.receiver]
}
