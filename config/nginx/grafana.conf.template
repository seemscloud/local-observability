server {
    listen 80;
    listen [::]:80;
    server_name ${GRAFANA_DOMAIN} ${PROMETHEUS_DOMAIN} ${COCKPIT_DOMAIN};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${COCKPIT_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/grafana/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grafana/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 20m;

    location = /_cockpit_login {
        internal;
        proxy_pass http://observability-cockpit:9090/cockpit/login;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization "Basic Y29tcDp4";
    }

    location = /healthz {
        proxy_pass http://observability-cockpit:9090/ping;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
    }

    location / {
        auth_request /_cockpit_login;
        auth_request_set $cockpit_login_cookie $upstream_http_set_cookie;
        auth_request_set $cockpit_session_id $upstream_cookie_cockpit;
        add_header Set-Cookie $cockpit_login_cookie always;

        proxy_pass http://observability-cockpit:9090;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie "$http_cookie; cockpit=$cockpit_session_id";
        proxy_set_header Authorization "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${PROMETHEUS_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/grafana/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grafana/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 20m;

    location / {
        proxy_pass http://observability-prometheus:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${GRAFANA_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/grafana/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grafana/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 20m;

    location / {
        proxy_pass http://observability-grafana:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-WEBAUTH-USER admin;
        proxy_set_header Authorization "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
